{
  "name": "hexu",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "start": "node bin/server.mjs",
    "account:add": "node bin/add-user.mjs",
    "test:browser": "playwright test --config ci/playwright.config.mjs",
    "test": "npm run test:core && npm run test:persistence && npm run test:tooling",
    "test:core": "node scripts/test-runner.mjs core",
    "test:persistence": "node scripts/test-runner.mjs persistence",
    "test:tooling": "node scripts/test-runner.mjs tooling",
    "test:deployment": "node scripts/test-runner.mjs deployment",
    "test:mutation": "node scripts/mutation.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run build && npm test",
    "readiness": "node scripts/readiness.mjs",
    "acceptance:product": "node scripts/readiness.mjs --require-product"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
